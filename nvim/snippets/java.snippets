# JavaFX snippets
snippet javafx "JavaFX Application template"
package ${1:com.example};

import javafx.application.Application;
import javafx.scene.Scene;
import javafx.scene.control.Label;
import javafx.scene.layout.StackPane;
import javafx.stage.Stage;

public class ${2:MainApp} extends Application {
    
    @Override
    public void start(Stage primaryStage) {
        ${3:Label label = new Label("Hello JavaFX!");}
        ${4:StackPane root = new StackPane(label);}
        
        Scene scene = new Scene(root, ${5:300}, ${6:250});
        
        primaryStage.setTitle("${7:JavaFX Application}");
        primaryStage.setScene(scene);
        primaryStage.show();
    }
    
    public static void main(String[] args) {
        launch(args);
    }
}
endsnippet

